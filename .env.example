# API keys are now managed via Azure Function proxy
# No local keys needed — see config-loader.html for status

# ── Hive Multi-Agent Backend ──────────────────────────────────────────────────
# URL of the Hive FastAPI bridge server (default: localhost:7433)
# Start with: .\backend\start.ps1
HIVE_API_URL=http://localhost:7433

# Canonical public origin used for metadata, canonical URLs, robots.txt, and sitemap.xml.
# Set this to the production domain in the hosting platform's environment variables.
NEXT_PUBLIC_SITE_URL=https://prismspace.app
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_replace_me
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Used by Next.js server routes. It can be the same project token, but keep
# this server-side variable out of client-exposed environment files in production.
POSTHOG_PROJECT_TOKEN=phc_replace_me
POSTHOG_HOST=https://us.i.posthog.com

# Grafana Cloud Hosted Prometheus + Alloy collector
GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-REPLACE.grafana.net/api/prom/push
GRAFANA_CLOUD_PROMETHEUS_USER=REPLACE_WITH_STACK_USER_ID
GRAFANA_CLOUD_API_KEY=REPLACE_WITH_GRAFANA_CLOUD_TOKEN

# Remote API metrics targets. Use host:443, without https://.
RENDER_METRICS_HOST=your-render-service.onrender.com:443
RENDER_METRICS_TOKEN=replace-with-api-metrics-token
RAILWAY_METRICS_HOST=your-service.up.railway.app:443
RAILWAY_METRICS_TOKEN=replace-with-api-metrics-token
CLOUDFLARE_METRICS_HOST=your-random-subdomain.trycloudflare.com:443
CLOUDFLARE_METRICS_TOKEN=replace-with-api-metrics-token
