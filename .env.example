# API keys are now managed via Azure Function proxy
# No local keys needed — see config-loader.html for status

# ── Hive Multi-Agent Backend ──────────────────────────────────────────────────
# URL of the Hive FastAPI bridge server (default: localhost:7433)
# Start with: .\backend\start.ps1
HIVE_API_URL=http://localhost:7433

# Canonical public origin used for metadata, canonical URLs, robots.txt, and sitemap.xml.
# Set this to the production domain in the hosting platform's environment variables.
NEXT_PUBLIC_SITE_URL=https://prismspace.app
