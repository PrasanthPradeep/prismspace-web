# =============================================================================
# Hive Backend — API Keys
# Rename this file to .env and add your real keys below.
# DO NOT commit the real .env to version control!
# =============================================================================

# OpenAI API Key (required if provider='openai')
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic API Key (required if provider='anthropic')
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key-here

# Google Gemini API Key (required if provider='google')
GEMINI_API_KEY=your-gemini-key-here

# Groq API Key (required if provider='groq')
GROQ_API_KEY=gsk_your_groq_key_here

# ── Per-user Gmail MCP (Google OAuth, one-time setup) ──
# From console.cloud.google.com → OAuth Web Client "PrismSpaceWeb client 1"
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Must exactly match Authorized redirect URI in console:
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace-with-generated-key
